<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build for Jellyfin 10.11 (net9.0) by default. For 10.10:
       dotnet build -c Release -p:TargetFramework=net8.0 -p:JellyfinVersion=10.10.* -->
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net9.0</TargetFramework>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">10.11.*</JellyfinVersion>
    <PluginVersion Condition="'$(PluginVersion)' == ''">1.0.0.0</PluginVersion>
    <RootNamespace>Jellyfin.Plugin.DvbHub</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.DvbHub</AssemblyName>
    <AssemblyVersion>$(PluginVersion)</AssemblyVersion>
    <FileVersion>$(PluginVersion)</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\dvbhub.html" />
  </ItemGroup>

</Project>
