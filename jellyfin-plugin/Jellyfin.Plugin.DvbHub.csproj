<Project Sdk="Microsoft.NET.Sdk">

  <!-- One source tree, three builds:
         Jellyfin 10.10: -p:JellyfinTfm=net8.0  -p:JellyfinVersion=10.10.*
         Jellyfin 10.11: -p:JellyfinTfm=net9.0  -p:JellyfinVersion=10.11.*
         Jellyfin 12.x:  -p:JellyfinTfm=net10.0 -p:JellyfinVersion=12.*   (the default)
       TargetFramework is derived from JellyfinTfm because NuGet restore
       ignores a TargetFramework given on the command line. -->
  <PropertyGroup>
    <JellyfinTfm Condition="'$(JellyfinTfm)' == ''">net10.0</JellyfinTfm>
    <TargetFramework>$(JellyfinTfm)</TargetFramework>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.*</JellyfinVersion>
    <PluginVersion Condition="'$(PluginVersion)' == ''">2.0.0.0</PluginVersion>
    <RootNamespace>Jellyfin.Plugin.DvbHub</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.DvbHub</AssemblyName>
    <AssemblyVersion>$(PluginVersion)</AssemblyVersion>
    <FileVersion>$(PluginVersion)</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\dvbhub.html" />
  </ItemGroup>

</Project>
